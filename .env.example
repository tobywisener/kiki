# Public browser configuration only. Never put server secrets in VITE_ variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_VAPID_PUBLIC_KEY=

# Local/server-only values. Never prefix these with VITE_.
SUPABASE_DB_PASSWORD=
SUPABASE_DB_HOST=
SUPABASE_DB_USER=postgres
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
MESSAGE_WEBHOOK_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
KIKI_EN_EMAIL=
KIKI_TH_EMAIL=
KIKI_EN_NAME=
KIKI_TH_NAME=

# Frontend upload: FTPS (FTP with TLS), normally port 21; implicit FTPS uses 990.
FRONTEND_FTP_HOST=
FRONTEND_FTP_PORT=21
FRONTEND_FTP_USER=
FRONTEND_FTP_PASSWORD=
# Remote document root: leading / means absolute; otherwise relative to FTP login.
FRONTEND_FTP_DIR=
